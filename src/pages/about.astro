---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from '../components/InnerHero.astro';

const values = [
  {
    number: '01',
    title: 'Integrity',
    body: 'We seek to be clear, consistent and accountable in our business relationships.',
  },
  {
    number: '02',
    title: 'Commercial discipline',
    body: 'We assess opportunities carefully and work towards structures that can support long-term value.',
  },
  {
    number: '03',
    title: 'Partnership',
    body: 'We value complementary expertise and clearly defined responsibilities.',
  },
  {
    number: '04',
    title: 'Responsibility',
    body: 'We consider safety, environmental protection and stakeholder relationships in our approach to investment.',
  },
];
---

<BaseLayout
  title="About Dawn Oil | Dawn Oil Limited"
  description="Learn about Dawn Oil Limited, its purpose and its commercially disciplined approach to upstream oil and gas investment opportunities in Nigeria."
>
  <InnerHero
    eyebrow="About Dawn Oil"
    title="About Dawn Oil"
    intro="Dawn Oil Limited is an upstream petroleum company focused on oil and gas investment opportunities in Nigeria."
    marker="02 — Company"
  />

  <section class="section section-white" aria-labelledby="who-we-are-title">
    <div class="container editorial-grid" data-reveal>
      <div class="section-heading">
        <p class="eyebrow">Who we are</p>
        <h2 id="who-we-are-title">A clear basis for upstream participation</h2>
      </div>
      <div class="editorial-copy inner-editorial-copy">
        <p class="lead">
          Our interests include upstream asset acquisitions, relevant licensing opportunities and partnerships that support the commercial development of energy resources.
        </p>
        <p>
          We seek to bring together experienced professionals and suitable partners to evaluate opportunities with care and pursue transactions on a sound commercial basis.
        </p>
        <p>
          Our approach places emphasis on clear strategy, disciplined decision-making and a practical understanding of the Nigerian energy environment.
        </p>
      </div>
    </div>
  </section>

  <section class="purpose-band" aria-labelledby="purpose-title">
    <div class="container purpose-grid" data-reveal>
      <p class="eyebrow eyebrow-amber">Our purpose</p>
      <h2 id="purpose-title">To build a credible upstream energy business through carefully selected opportunities, strong partnerships and responsible business practices.</h2>
    </div>
  </section>

  <section class="section section-cream" aria-labelledby="approach-title">
    <div class="container approach-grid">
      <div data-reveal>
        <p class="eyebrow">Our approach</p>
        <h2 id="approach-title">Commercial thinking comes first.</h2>
      </div>
      <div class="approach-copy" data-reveal>
        <p class="lead">
          We start with the commercial case. We consider the quality of an opportunity, the capabilities required to progress it and the interests of the parties involved.
        </p>
        <p>
          We then work with relevant technical, operating and financial partners to develop an appropriate structure.
        </p>
        <p>
          We recognise that successful upstream investment requires more than a transaction. Long-term outcomes depend on capable management, safe operations, effective relationships and respect for the communities and environment connected to an asset.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="values-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <div>
          <p class="eyebrow">Our values</p>
          <h2 id="values-title">Principles for how we approach opportunity</h2>
        </div>
        <p>Clear judgement, complementary expertise and responsible relationships guide the business we seek to build.</p>
      </div>

      <div class="values-grid">
        {values.map((value, index) => (
          <article class="value-card" data-reveal style={`--delay: ${index * 70}ms`}>
            <span>{value.number}</span>
            <h3>{value.title}</h3>
            <p>{value.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-cta" aria-labelledby="about-cta-title">
    <div class="container contact-inner" data-reveal>
      <p class="eyebrow eyebrow-light">The experience behind our business</p>
      <h2 id="about-cta-title">Leadership shapes our strategy, partnerships and growth.</h2>
      <a class="button button-light" href="/#leadership">Our leadership <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
