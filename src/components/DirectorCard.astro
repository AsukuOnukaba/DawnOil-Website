---
import type { DirectorProfile } from '../types/leadership';

interface Props {
  profile: DirectorProfile;
  biographyHref: string;
}

const { profile, biographyHref } = Astro.props;
---

<article class="director-card" data-director-card data-reveal>
  <img
    src={profile.portraitSrc}
    alt={profile.portraitAlt}
    width="960"
    height="1200"
    loading="lazy"
  />
  <div class="director-card-copy">
    <p class="eyebrow">{profile.title}</p>
    <h2>{profile.publicName}</h2>
    <p>{profile.shortBiography}</p>
    <a class="text-link" href={biographyHref}>Read biography <span aria-hidden="true">↗</span></a>
  </div>
</article>
